<Project>

  <!-- When used as a submodule, chain to the host repo's Directory.Build.props
       which can set NevmDepsRoot to point at the host's shared projects. -->
  <PropertyGroup>
    <_NevmParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_NevmParentProps>
  </PropertyGroup>
  <Import Project="$(_NevmParentProps)" Condition="'$(_NevmParentProps)' != ''" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>14.0</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="ProductInfo">
    <Copyright>Demerzel Solutions Limited</Copyright>
    <Product>Nevm</Product>
  </PropertyGroup>

  <!-- Configurable dependency root: when built standalone, points to local src/.
       When used as a submodule in Nethermind, override via a Directory.Build.props
       placed in the submodule mount point. -->
  <PropertyGroup>
    <NevmDepsRoot Condition="'$(NevmDepsRoot)' == ''">$(MSBuildThisFileDirectory)src/</NevmDepsRoot>
  </PropertyGroup>

</Project>
